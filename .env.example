# PostgreSQL
POSTGRES_DB=tg_client
POSTGRES_USER=tg_client
POSTGRES_PASSWORD=change-me
# Optional override. If POSTGRES_PASSWORD contains URL-special characters, URL-encode it here.
# DATABASE_URL=postgresql+psycopg://tg_client:change-me@postgres:5432/tg_client

# Backend API
API_ROOT_PATH=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
TRAEFIK_HTTP_PORT=8080
LOG_LEVEL=INFO

# Auth and security
JWT_SECRET_KEY=change-me-generate-a-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Development-only example key. Generate a unique value for every deployment.
SESSION_ENCRYPTION_KEY=tGrK4mP6uvgxNu35EHLf-MagEBO8LGgpTZgWsUFYdTg=

# Admin bootstrap
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# Telegram shared app credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_DEVICE_MODEL=
TELEGRAM_SYSTEM_VERSION=
TELEGRAM_APP_VERSION=

# Limits
MAX_ACCOUNTS_PER_USER=5
SYNC_INTERVAL_SECONDS=120
MESSAGES_PER_CHAT=100

# Frontend
VITE_API_BASE_URL=/api
